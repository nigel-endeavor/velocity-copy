{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "types": ["node"],
    "lib": ["es2020"],
    "outDir": "./dist/e2e",
    "noPropertyAccessFromIndexSignature": false,
    "strict": true
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "src"]
}
