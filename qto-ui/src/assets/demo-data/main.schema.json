{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "main demo data schema",
  "title": "main demo data schema",
  "description": "how all demo data files should look",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "toplevel": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "payloads": {
          "$ref": "#/definitions/payloads"
        }
      }
    },
    "payloads": {
      "type": "array",
      "additionalItems": false,
      "items": {
        "$ref": "#/definitions/payload"
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "value"
      ],
      "properties": {
        "args": {
          "type": "object"
        },
        "method": {
          "type": "string",
          "enum": ["post", "put", "delete", "patch", "get"]
        },
        "error": {
          "type": "number"
        },
        "value": { }
      }
    }
  }
}
