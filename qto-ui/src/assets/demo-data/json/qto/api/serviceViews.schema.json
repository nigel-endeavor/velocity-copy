                      "networkProviderFoc": { "type":  "string"},
                      "openJeop": { "type":  "string"},
                      "orderId": { "type":  "number"},
                      "orderType": { "type":  "string"},
                      "projectManager": { "type":  "string"},
                      "provisioner": { "type":  "string"},
