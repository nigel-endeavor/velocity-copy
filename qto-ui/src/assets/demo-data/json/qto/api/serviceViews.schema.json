                      "showNoteIcon": { "type":  "boolean"},
                      "siteSurveyDue": { "type":  "string"},
                      "siteSurveySubmit": { "type":  "string"},
                      "speed": { "type":  "string"},
                      "status": { "type":  "string"},
                      "type": { "type":  "string"},
                      "version": { "type":  "number"},
                      "vertekProjectManager": { "type":  "string"}
