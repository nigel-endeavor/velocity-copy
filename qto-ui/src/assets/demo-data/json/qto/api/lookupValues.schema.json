{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "get-subjects",
  "title": "Values",
  "description": "/lookupValues",
  "type": "object",
  "additionalProperties": false,
  "$ref": "../../../main.schema.json#/definitions/toplevel",
  "properties": {
    "payloads": {
      "type": "array",
      "items": {
