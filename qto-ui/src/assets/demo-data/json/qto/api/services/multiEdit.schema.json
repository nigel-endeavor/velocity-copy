{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "post-multiedit",
  "title": "Multiedit",
  "description": "/multiEdit",
  "type": "object",
  "additionalProperties": false,
  "$ref": "../../../../main.schema.json#/definitions/toplevel",
  "properties": {
    "payloads": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/payload"
      }
    }
  },
  "definitions": {
    "payload": {
      "allOf": [
        {
          "$ref": "../../../../main.schema.json#/definitions/payload"
        },
        {
          "properties": {
            "value": {
              "type": "object",
              "properties": {
                "fieldValues": {
                  "type": "object",
                  "properties": {
                    "carrier": {"type": "string"},
                    "clientLocationInfo": {"type": "string"},
                    "clientLocationType": {"type": "string"},
                    "clientProjectManager": {"type": "string"},
                    "downloadSpeed": {"type": "string"},
                    "jeopNote": {"type": "string"},
                    "mediaType": {"type": "string"},
                    "networkProtocol": {"type": "string"},
                    "serviceNote": {"type": "string"},
                    "uploadSpeed": {"type": "string"},
                    "jeopAssignedTo": {"type": "number"},
                    "jeopDescription": {"type": "number"},
                    "jeopResponsibility": {"type": "number"},
                    "jeopStartDate": {"type": "number"},
                    "mrc": {"type": "number"},
                    "nrc": {"type": "number"},
                    "provisioner": {"type": "number"},
                    "vertekProjectManager": {"type": "number"}
                  }
                },
                "milestones": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": { "type": "string" },
                      "date": { "type": "number" }
                    }
                  }
                },
                "serviceIds": {
                  "type": "array",
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
