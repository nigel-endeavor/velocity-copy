        <properties>
            <!--
              To show Hibernate SQL at runtime w/out rebuilding, enable a JBoss logging category for
              org.hibernate.SQL with log level ALL: (Profile -> Core -> Logging -> Log Categories)
              Please do not commit this file with hibernate.show_sql=true as this may
              make it into prod with no way to turn it off except to produce a new release.
            -->
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.generate_statistics" value="false"/>
            <property name="hibernate.use_sql_comments" value="true"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQL95Dialect"/>
        </properties>
