        <sql>update milestone_display_set_include set milestone_sequence = 3020 where milestone_display_set_id = (select mds.milestone_display_set_id from milestone_display_set mds where mds.display_group = '4G5G_SERVICE_MILESTONE') and milestone_id = (select m.milestone_id from milestone m where m.milestone_code = 'COMPLETE');</sql>
