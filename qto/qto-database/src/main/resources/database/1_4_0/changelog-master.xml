    <changeSet id="1_4_0-006" author="rcasey">
        <sql>
            INSERT INTO cost_history (service_id, cost_type, new_value, change_reason, update_date, master_customer_id, tenant_id, type_carrier)
            SELECT s.service_id, 'MRC', s.service_mrc, 'Initial Cost', now(), s.master_customer_id, s.tenant_id, CONCAT(s.service_type, ': ', s.carrier)
            FROM service s
                     JOIN inventory_location_service ils ON s.service_id = ils.service_id
            WHERE s.service_id NOT IN (
                SELECT service_id FROM cost_history WHERE change_reason = 'Initial Cost'
            );
        </sql>
    </changeSet>

