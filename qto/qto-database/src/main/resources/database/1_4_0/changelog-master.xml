    <changeSet id="1_4_0-012" author="rcasey">
        <sql>
            UPDATE lookup_value SET
                lookup_display = 'Replace Service - Change in floor/suite/MPOE/campus building',
                lookup_value = 'Replace Service - Change in floor/suite/MPOE/campus building'
            WHERE lookup_display = 'New Service - Change in floor/suite/MPOE/campus building'
                AND lookup_value = 'New Service - Change in floor/suite/MPOE/campus building';
            UPDATE lookup_value SET
                lookup_display = 'Replace Service - Change in main address',
                lookup_value = 'Replace Service - Change in main address'
            WHERE lookup_display = 'New Service - Change in main address'
                AND lookup_value = 'New Service - Change in main address';
            UPDATE lookup_value SET
                lookup_display = 'Replace Service - Change Carrier/Vendor',
                lookup_value = 'Replace Service - Change Carrier/Vendor'
            WHERE lookup_display = 'New Service - Change carrier'
              AND lookup_value = 'New Service - Change carrier';
            UPDATE lookup_value SET
                lookup_display = 'Replace Service - Speed change',
                lookup_value = 'Replace Service - Speed change'
            WHERE lookup_display = 'New Service - Speed change'
              AND lookup_value = 'New Service - Speed change';
            INSERT INTO lookup_value (lookup_type_id, lookup_display, lookup_value, sort_seq, modifiable, lookup_value_active, parent_lookup_value_id)
            VALUES (
                    (SELECT lookup_type_id FROM lookup_type WHERE lookup_type_code = 'SUB_ORDER_TYPE'),
                    'Replace Service - Same Carrier/Vendor', 'Replace Service - Same Carrier/Vendor', 10, 1, 1,
                    (
                        SELECT lv.lookup_value_id
                        FROM lookup_value lv
                        WHERE lv.lookup_type_id = (
                            SELECT lt.lookup_type_id
                            FROM lookup_type lt
                            WHERE lt.lookup_type_code = 'ORDER_TYPE'
                        ) AND lv.lookup_value = 'Change'
                        LIMIT 1
                   )
                   );
            set @tenantId = (select tenant_id from v_tenant where name = 'QTO First Tenant');
            INSERT INTO tenant_lookup_value (lookup_value_id, tenant_id)
            SELECT lookup_value_id, @tenantId
            FROM lookup_value
            WHERE lookup_value = 'Replace Service - Same Carrier/Vendor';
            set @tenantId = (select tenant_id from v_tenant where name = 'Endeavor');
            INSERT INTO tenant_lookup_value (lookup_value_id, tenant_id)
            SELECT lookup_value_id, @tenantId
            FROM lookup_value
            WHERE lookup_value = 'Replace Service - Same Carrier/Vendor';
        </sql>
    </changeSet>
    
