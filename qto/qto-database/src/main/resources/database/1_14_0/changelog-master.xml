    <changeSet id="1_14_0-01" author="fcurran">
        <addColumn tableName="note">
            <column name="subject_id" type="int"/>
        </addColumn>
    </changeSet>

    <changeSet id="1_14_0-02" author="fcurran">
        <comment>Update old notes subject_id based on created_by where possible.</comment>
        <sql>
            update note as n1
                inner join (
                select n.note_id, s.subject_id from note n
                inner join v_subject s on s.display_name = n.created_by
                ) as n2 on n1.note_id = n2.note_id
                set n1.subject_id = n2.subject_id;
        </sql>
    </changeSet>

    <changeSet id="1_14_0-03" author="fcurran">
        <addColumn tableName="note">
            <column name="edited_by" type="varchar(200)"/>
            <column name="edited_date" type="timestamp"/>
        </addColumn>
        <renameColumn tableName="note" oldColumnName="subject_id" newColumnName="created_by_id" columnDataType="int"/>
    </changeSet>

