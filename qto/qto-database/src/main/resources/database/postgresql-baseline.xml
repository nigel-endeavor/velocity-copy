<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- PostgreSQL baseline for QTO platform -->
    <!-- Schema created via Hibernate ddl-auto from JPA entities -->
    <!-- All legacy MySQL changelogs (1_0_0 through 1_18_1) are superseded -->

    <changeSet id="pg-baseline-001" author="migration">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <comment>Ensure platform schema exists for multi-tenant entities</comment>
        <sql>CREATE SCHEMA IF NOT EXISTS platform;</sql>
    </changeSet>

    <changeSet id="pg-baseline-002" author="migration">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
        </preConditions>
        <tagDatabase tag="postgresql-baseline-v1.18.1"/>
    </changeSet>

</databaseChangeLog>
