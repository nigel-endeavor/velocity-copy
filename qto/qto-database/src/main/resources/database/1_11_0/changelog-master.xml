    <changeSet id="1_11_0-011" author="fcurran">
        <comment>Break out service brokerage info.</comment>
        <createTable tableName="service_brokerage">
            <column name="service_brokerage_id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_id" type="int">
                <constraints nullable="false" foreignKeyName="FK_brokerage_service"
                             references="service(service_id)"/>
            </column>
            <!-- unchanged existing columns -->
            <column name="submitted_in_adv_to_provider" type="boolean" defaultValueBoolean="false"/>
            <column name="parent_tsd" type="varchar(100)"/>
            <column name="submitted_in_adv_to_tsd" type="boolean" defaultValueBoolean="false"/>
            <column name="cie_teamed_deal_info" type="varchar(100)"/>
            <column name="sfa_opportunity_num" type="varchar(100)"/>
            <column name="net_provider_points" type="varchar(100)"/>
            <column name="promotions" type="varchar(500)"/>
            <column name="commissionable_mrc" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="commissionable_nrc" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="commissionable_arc" type="decimal(19,2)" defaultValueNumeric="0"/>
            <!-- new columns -->
            <!-- brokerage and agency -->
            <column name="commissions_supplier" type="varchar(100)"/>
            <column name="commissions_account_number" type="varchar(100)"/>
            <column name="sub_agent_percent" type="decimal(5,2)"/>
            <column name="sub_agent" type="varchar(100)"/>
            <column name="sub_agent_rep" type="varchar(100)"/>
            <column name="secondary_agency" type="varchar(100)"/>
            <column name="secondary_agency_rep" type="varchar(100)"/>
            <column name="tertiary_agency" type="varchar(100)"/>
            <column name="tertiary_agency_rep" type="varchar(100)"/>
            <column name="referral" type="bit" defaultValueBoolean="false"/>
            <column name="referral_name" type="varchar(100)"/>
            <column name="company_referral_percent" type="decimal(5,2)"/>
            <!-- order details -->
            <column name="spiff_amount" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="customer_order_alias" type="varchar(100)"/>
            <column name="engineer_resource" type="bit" defaultValueBoolean="false"/>
            <column name="engineer_resource_allocation" type="decimal(5,2)"/>
            <!-- commissions -->
            <column name="commission_payment_type" type="varchar(100)"/>
            <column name="expected_commission" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="commission_reduction_percent" type="decimal(5,2)"/>
            <column name="commission_icb" type="bit" defaultValueBoolean="false"/>
            <column name="internal_commissions_comments" type="varchar(500)"/>
            <!-- profit monitoring -->
            <column name="gross_profit_mrc_multiplier" type="decimal(5,2)"/>
            <column name="percent_resides_from_carrier" type="varchar(100)"/>
            <column name="gross_profit_mrc" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="gross_profit" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="gross_profit_mrc_needs_to_be_edited" type="bit" defaultValueBoolean="false"/>
            <column name="gross_profit_needs_to_be_edited" type="bit" defaultValueBoolean="false"/>
            <column name="gross_profit_mrc_override" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="gross_profit_override" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="rep_gross_profit_production" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="total_contract_value" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="uplift_mrc" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="subaccount_mrc" type="decimal(19,2)" defaultValueNumeric="0"/>
            <column name="master_customer_id" type="int"/>
            <column name="tenant_id" type="int"/>
            <column name="version" type="int"/>
        </createTable>
    </changeSet>

