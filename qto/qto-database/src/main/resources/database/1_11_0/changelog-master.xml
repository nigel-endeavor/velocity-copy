    <changeSet id="1_11_0-16" author="fcurran">
        <sql>
            UPDATE lookup_type set category = 'Brokerage' where lookup_type_code in ('SUB_AGENT', 'BROKERAGE', 'COMMISSIONS_PAYMENT_TYPE');
            INSERT INTO lookup_type (lookup_type_descr, lookup_type_code, lookup_type_active, modifiable, sort_strategy, category)
            VALUES ('Commissions Supplier', 'COMMISSIONS_SUPPLIER', 1, 1, 0, 'Brokerage');
            UPDATE lookup_type set lookup_type_code = 'AGENCY_NAME', lookup_type_descr = 'Agency Name' where lookup_type_code = 'SUB_AGENT';
            INSERT INTO lookup_type (lookup_type_descr, lookup_type_code, lookup_type_active, modifiable, sort_strategy, category, parent_lookup_type_id)
            SELECT 'Agency Rep', 'AGENCY_REP', 1, 1, 0, 'Brokerage', parent.lookup_type_id
            FROM (SELECT lookup_type_id FROM lookup_type WHERE lookup_type_code = 'AGENCY_NAME') as parent;
        </sql>
    </changeSet>

