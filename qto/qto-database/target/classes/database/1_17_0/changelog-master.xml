    <changeSet id="1_17_0-01" author="mwelicka">
        <comment>refactor custom worklists</comment>
        <createTable tableName="custom_worklist">
            <column name="custom_worklist_id" type="int" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="author_id" type="long"/>
            <column name="content" type="longtext"/>
            <column name="shared" type="boolean" defaultValueBoolean="false"/>
            <column name="worklist_name" type="varchar(100)"/>
            <column name="name" type="varchar(100)"/>
            <column name="last_modified_date" type="datetime"/>
            <column name="version" type="int" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1_17_0-02" author="mwelicka">
        <comment>refactor custom worklists</comment>
        <addColumn tableName="subject_custom_worklist">
            <column name="custom_worklist_id" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="subject_id" type="int"/>
            <column name="favorite" type="boolean" defaultValueBoolean="false"/>
            <column name="last_viewed_date" type="datetime"/>
        </addColumn>
    </changeSet>

     <changeSet id="1_17_0-03" author="mwelicka">
         <sql>
             ALTER TABLE custom_worklist
                 ADD COLUMN subject_custom_worklist_id int;

             INSERT INTO custom_worklist (subject_custom_worklist_id, author_id, content, shared, worklist_name, name,
                                          tenant_id)
                 (SELECT subject_custom_worklist_id, author_id, content, shared, worklist_name, name, tenant_id
                  FROM subject_custom_worklist);

             UPDATE subject_custom_worklist
             SET custom_worklist_id = (SELECT c.custom_worklist_id
                                       FROM custom_worklist c
                                       WHERE c.subject_custom_worklist_id =
                                             subject_custom_worklist.subject_custom_worklist_id);

             ALTER TABLE custom_worklist DROP COLUMN subject_custom_worklist_id;
         </sql>
     </changeSet>


    <changeSet id="1_17_0-04" author="mwelicka">
        <comment>Adding Foreign Key</comment>
        <addForeignKeyConstraint baseTableName="subject_custom_worklist"
                                 baseColumnNames="custom_worklist_id"
                                 constraintName="FK_subject_custom_worklist_custom_worklist"
                                 referencedTableName="custom_worklist"
                                 referencedColumnNames="custom_worklist_id"/>
    </changeSet>

     <changeSet id="1_17_0-05" author="mwelicka">
         <sql>
             UPDATE subject_custom_worklist
             SET subject_id = (SELECT c.author_id
                                       FROM custom_worklist c
                                       WHERE c.custom_worklist_id =
                                             subject_custom_worklist.custom_worklist_id);
         </sql>
     </changeSet>

    <changeSet id="1_17_0-06" author="mwelicka">
        <comment>dropping tenant_id not null constraint</comment>
        <dropNotNullConstraint
                tableName="subject_custom_worklist"
                columnDataType="int"
                columnName="tenant_id"/>
    </changeSet>

    <changeSet id="1_17_0-07" author="mwelicka">
        <sql>
            UPDATE subject_custom_worklist
            SET last_viewed_date = now()
            WHERE last_viewed_date IS NULL;

            UPDATE custom_worklist
            SET last_modified_date = now()
            WHERE custom_worklist.last_modified_date IS NULL;
        </sql>
    </changeSet>

