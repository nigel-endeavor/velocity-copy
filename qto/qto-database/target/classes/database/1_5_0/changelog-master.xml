    <changeSet id="1_5_0-0015" author="rcasey">
        <sql>
            SET @lookupTypeId = (SELECT lookup_type_id FROM lookup_type WHERE lookup_type_code = 'ACCESS_TYPE');
            DELETE FROM tenant_lookup_value WHERE lookup_value_id IN (SELECT lookup_value_id FROM lookup_value WHERE lookup_type_id = @lookupTypeId);
            DELETE FROM lookup_value WHERE lookup_type_id = @lookupTypeId;

            INSERT INTO lookup_value (lookup_type_id, lookup_display, lookup_value, sort_seq, lookup_value_active)
            VALUES (@lookupTypeId, 'Ethernet Over Fiber', 'Ethernet Over Fiber', 10, 1),
                (@lookupTypeId, 'Ethernet Over Copper', 'Ethernet Over Copper', 20, 1),
                (@lookupTypeId, 'Ethernet Over DS-3', 'Ethernet Over DS-3', 30, 1),
                (@lookupTypeId, 'Ethernet Over T-1', 'Ethernet Over T-1', 40, 1),
                (@lookupTypeId, 'Ethernet Over Copper - Phone Lines', 'Ethernet Over Copper - Phone Lines', 50, 1);

            INSERT INTO tenant_lookup_value (lookup_value_id, tenant_id)
            SELECT lookup_value_id, t.tenant_id
            FROM lookup_value
                     join v_tenant t
            WHERE lookup_type_id = @lookupTypeId;
        </sql>
    </changeSet>

