                   (@lookupTypeId, 'Telarus', 'Telarus', 0, 1, (Select tenant_id from v_tenant t where t.name = 'Endeavor')),
                   (@lookupTypeId, 'Avant', 'Avant', 0, 1, (Select tenant_id from v_tenant t where t.name = 'Endeavor')),
                   (@lookupTypeId, 'Telarus', 'Telarus', 0, 1, (Select tenant_id from v_tenant t where t.name = 'Endeavor')),
                   (@lookupTypeId, 'Avant', 'Avant', 0, 1, (Select tenant_id from v_tenant t where t.name = 'Endeavor'));
        </sql>
    </changeSet>

