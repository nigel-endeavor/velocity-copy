<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- QTO Database Changelog - Version 1.0 -->
    <!-- Initial schema setup for PostgreSQL -->

    <changeSet id="1.0.0-create-schema-version" author="qto-team">
        <comment>Create schema_version tracking table for application metadata</comment>
        <createTable tableName="schema_version">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>
            <column name="applied_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1.0.1-insert-initial-version" author="qto-team">
        <comment>Record initial schema version</comment>
        <insert tableName="schema_version">
            <column name="version" value="1.0.0"/>
            <column name="description" value="Initial QTO schema - PostgreSQL with Liquibase"/>
        </insert>
    </changeSet>

</databaseChangeLog>
